# Cipher Clash — Environment Configuration
# Copy to .env and replace every placeholder (./start.sh does this for you,
# generating strong random secrets). Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=cipher_clash
# Used by services running on the host (start.sh / make dev-*)
DATABASE_URL=postgres://postgres:change-me-postgres-password@localhost:5432/cipher_clash?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change-me-redis-password

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=cipher_clash
RABBITMQ_URL=amqp://admin:change-me-rabbitmq-password@localhost:5672/cipher_clash

# ── JWT (shared by every service; min 32 chars) ─────────────────────────────
JWT_SECRET=change-me-jwt-secret-minimum-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Service-to-service auth (puzzle solutions, rating updates) ──────────────
INTERNAL_API_TOKEN=change-me-internal-api-token

# ── Canonical service ports ─────────────────────────────────────────────────
ACHIEVEMENT_SERVICE_PORT=8083
MISSIONS_SERVICE_PORT=8084
AUTH_SERVICE_PORT=8085
MATCHMAKER_PORT=8086
PUZZLE_ENGINE_PORT=8087
GAME_SERVICE_PORT=8088
TUTORIAL_SERVICE_PORT=8089
PRACTICE_SERVICE_PORT=8090
MASTERY_SERVICE_PORT=8091
SOCIAL_SERVICE_PORT=8092
COSMETICS_SERVICE_PORT=8093

# ── Inter-service URLs (host-mode defaults) ─────────────────────────────────
PUZZLE_ENGINE_URL=http://localhost:8087
MATCHMAKER_URL=http://localhost:8086

# ── Web client / CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
